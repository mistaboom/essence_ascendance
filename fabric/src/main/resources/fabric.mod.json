{
  "schemaVersion": 1,
  "id": "essence_ascendance",
  "version": "${version}",
  "name": "Essence Ascendance",
  "icon": "icon.png",
  "description": "Consume vast quantities of items to ascend your character and permanently improve combat, mobility, defense, and other abilities.",
  "authors": [
    "MistaBoom"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mistaboom.essence_ascendance.fabric.EssenceAscendanceFabric"
    ],
    "client": [
      "com.mistaboom.essence_ascendance.fabric.client.EssenceAscendanceFabricClient"
    ],
    "jei_mod_plugin": [
      "com.mistaboom.essence_ascendance.compat.jei.EssenceAscendanceJeiPlugin"
    ]
  },
  "mixins": [
    "essence_ascendance.mixins.json",
    "essence_ascendance.damage.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_requirement}",
    "minecraft": "${minecraft_requirement}",
    "java": "${java_requirement}",
    "architectury": "${architectury_requirement}",
    "fabric-api": "*"
  },
  "accessWidener": "essence_ascendance.accesswidener"
}
